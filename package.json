{
  "name": "gnome-lyricbar",
  "version": "0.1.15",
  "description": "Production-grade GNOME Shell extension for synced live lyrics in the top bar.",
  "license": "MIT",
  "homepage": "https://github.com/fikrilal/gnome-lyricbar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fikrilal/gnome-lyricbar.git"
  },
  "bugs": {
    "url": "https://github.com/fikrilal/gnome-lyricbar/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "inspect:mpris": "node scripts/inspect-mpris.mjs",
    "verify": "npm run verify:safe",
    "verify:safe": "npm run verify:docs && npm run validate:metadata && npm run validate:schema && npm run check:architecture && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:extension && npm run validate:bundle",
    "verify:docs": "node scripts/validate-docs.mjs",
    "validate:metadata": "node scripts/validate-metadata.mjs",
    "validate:schema": "node scripts/validate-schema.mjs",
    "validate:bundle": "node scripts/validate-bundle.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "commitlint": "commitlint",
    "setup:hooks": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
