{
  "name": "gnome-lyricbar",
  "version": "0.1.3",
  "description": "Production-grade GNOME Shell extension for synced live lyrics in the top bar.",
  "license": "MIT",
  "homepage": "https://github.com/fikrilal/gnome-lyricbar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fikrilal/gnome-lyricbar.git"
  },
  "bugs": {
    "url": "https://github.com/fikrilal/gnome-lyricbar/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "verify": "npm run verify:safe",
    "verify:safe": "npm run verify:docs && npm run validate:metadata && npm run validate:schema && npm run check:architecture && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:extension",
    "verify:docs": "node scripts/validate-docs.mjs",
    "validate:metadata": "node scripts/validate-metadata.mjs",
    "validate:schema": "node scripts/validate-schema.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.19.19",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
