{
  "name": "gnome-lyricbar",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade GNOME Shell extension for synced live lyrics in the top bar.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "verify": "npm run verify:safe",
    "verify:safe": "npm run verify:docs && npm run validate:metadata && npm run validate:schema && npm run check:architecture && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:extension",
    "verify:docs": "node scripts/validate-docs.mjs",
    "commitlint": "commitlint",
    "validate:metadata": "node scripts/validate-metadata.mjs",
    "validate:schema": "node scripts/validate-schema.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.19.19",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
